---
import MusicPlayer from "../components/MusicPlayer.astro";
import "../styles/theme.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TLH - Transformamos ideas en experiencias digitales",
  description = "Creamos soluciones web modernas y escalables que impulsan el crecimiento de tu negocio. Desarrollo web, aplicaciones móviles, diseño UX/UI y más.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/tlh.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="desarrollo web, aplicaciones móviles, diseño UX/UI, desarrollo frontend, desarrollo backend, consultoría tecnológica"
    />
    <meta name="author" content="TLH" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/tlh.ico" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/tlh.ico" />

    <!-- Additional Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#667eea" />

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <!-- MusicPlayer /> -->
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    line-height: 1.6;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.06);
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 60%, rgba(34, 211, 238, 0.7) 140%);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.95) 0%, rgba(139, 92, 246, 0.95) 60%, rgba(34, 211, 238, 0.8) 140%);
  }

  /* Selection styles */
  ::selection {
    background: rgba(139, 92, 246, 0.28);
    color: rgba(255, 255, 255, 0.95);
  }

  /* Focus styles */
  :where(a, button, input, textarea, select, [tabindex]):focus-visible {
    outline: 2px solid rgba(167, 139, 250, 0.9);
    outline-offset: 2px;
    border-radius: 10px;
  }

  /* Smooth transitions for all interactive elements */
  a,
  button,
  input,
  textarea,
  select {
    transition: all 0.3s ease;
  }
</style>
