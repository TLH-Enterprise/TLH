---
import "../styles/theme.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TLH — Consultoría, desarrollo de software y marketing",
  description = "Firma de consultoría y desarrollo de software. Construimos productos digitales, integramos IA y ejecutamos estrategias de marketing y contenido para empresas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/tlh.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="consultoría tecnológica, desarrollo de software a la medida, aplicaciones móviles, inteligencia artificial, marketing digital, producción audiovisual"
    />
    <meta name="author" content="TLH" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/tlh.ico" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/tlh.ico" />

    <!-- Additional Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#6d28d9" />

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    line-height: 1.6;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f0f5;
  }

  ::-webkit-scrollbar-thumb {
    background: #c9c5d4;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #6d28d9;
  }

  /* Selection styles */
  ::selection {
    background: rgba(109, 40, 217, 0.16);
    color: #18141f;
  }

  /* Focus styles */
  :where(a, button, input, textarea, select, [tabindex]):focus-visible {
    outline: 2px solid #6d28d9;
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
