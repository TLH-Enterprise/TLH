---
---

<header class="tac-header" role="banner">
  <div class="tac-header__inner">
    <a href="/" class="tac-brand" aria-label="TLH Home">
      <span class="tac-brand__mark" aria-hidden="true">TLH</span>
      <span class="tac-brand__divider" aria-hidden="true">/</span>
      <span class="tac-brand__section">VALORANT</span>
    </a>
    <div class="tac-header__meta">
      <button type="button" class="tac-header-btn tac-header-btn--menu" id="tac-menu-btn" aria-label="Abrir menú" aria-controls="tac-intel" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <button type="button" class="tac-header-btn tac-header-btn--live" id="tac-live-btn" aria-label="Abrir intel en vivo" aria-controls="tac-live" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </button>
      <time id="tac-updated" class="tac-timestamp" datetime="">Cargando datos…</time>
      <div class="tac-notify">
        <button type="button" class="tac-notify__btn" id="tac-notify-btn" aria-label="Próximos torneos" aria-controls="tac-notify-panel" aria-expanded="false" title="Próximos torneos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="tac-notify__badge" id="tac-notify-badge" hidden></span>
        </button>
        <div class="tac-notify__panel" id="tac-notify-panel" role="dialog" aria-labelledby="tac-notify-title" hidden>
          <div class="tac-notify__head">
            <span class="tac-notify__title" id="tac-notify-title">Próximos torneos</span>
            <span class="tac-notify__meta" id="tac-notify-meta"></span>
          </div>
          <div class="tac-notify__list" id="tac-notify-list"></div>
          <div class="tac-notify__foot" id="tac-notify-foot"></div>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="tac-main" id="tac-main">
  <div class="tac-layout">
    <!-- INTEL RAIL - Left navigation -->
    <aside class="tac-intel" id="tac-intel" aria-label="Navegación táctica">
      <nav class="tac-tabs" id="tac-tabs" role="tablist" aria-label="Vistas del equipo y jugadores">
        <!-- Tabs injected by JS -->
      </nav>

      <div class="tac-filters" id="tac-filters" role="search" aria-label="Filtros de partida">
        <fieldset class="tac-filter-group" aria-label="Modo de juego">
          <legend class="tac-filter-label">MODO</legend>
          <div class="tac-segmented" role="group" aria-label="Seleccionar modos">
            <label class="tac-segment">
              <input type="checkbox" name="mode" value="premier" checked>
              <span class="tac-segment__content">
                <svg class="tac-segment__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><path d="M12 22V12M22 15.5L12 12M2 8.5L12 12"/></svg>
                <span>Premier</span>
                <span class="tac-segment__badge" aria-live="polite"></span>
              </span>
            </label>
            <label class="tac-segment">
              <input type="checkbox" name="mode" value="custom" checked>
              <span class="tac-segment__content">
                <svg class="tac-segment__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Scrims/Torneos</span>
                <span class="tac-segment__badge" aria-live="polite"></span>
              </span>
            </label>
            <label class="tac-segment">
              <input type="checkbox" name="mode" value="competitive">
              <span class="tac-segment__content">
                <svg class="tac-segment__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span>Ranked</span>
                <span class="tac-segment__badge" aria-live="polite"></span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="tac-filter-group" aria-label="Periodo">
          <legend class="tac-filter-label">PERIODO</legend>
          <div class="tac-toggle" role="group" aria-label="Seleccionar periodo">
            <input type="radio" name="period" value="act" id="period-act" checked>
            <label for="period-act" class="tac-toggle__btn">Este acto</label>
            <input type="radio" name="period" value="all" id="period-all">
            <label for="period-all" class="tac-toggle__btn">Todo el historial</label>
          </div>
        </fieldset>
      </div>
    </aside>

    <!-- ACTIVE CANVAS - Center content -->
    <section class="tac-canvas" id="tac-canvas" aria-live="polite" role="main">
      <div class="tac-canvas__header">
        <h1 class="tac-canvas__title" id="tac-view-title">División de Valorant</h1>
        <p class="tac-canvas__subtitle" id="tac-view-subtitle">Selecciona una vista en el panel izquierdo</p>
      </div>
      <div class="tac-canvas__body" id="tac-content">
        <!-- Content injected by JS -->
      </div>
    </section>

    <!-- LIVE INSIGHTS - Right panel (collapsible on mobile) -->
    <aside class="tac-live" id="tac-live" aria-label="Panel de insights en vivo" hidden>
      <div class="tac-live__header">
        <h2 class="tac-live__title">INTEL EN VIVO</h2>
        <button type="button" class="tac-live__close" aria-label="Cerrar panel" hidden>&times;</button>
      </div>
      <div class="tac-live__body" id="tac-live-content">
        <!-- Injected by JS -->
      </div>
    </aside>
  </div>
</main>

<script src="../../scripts/valorant.ts"></script>

<style is:global>
  /* ==========================================================================
     TACTICAL DESIGN TOKENS (scoped to valorant page)
     ========================================================================== */
  :root {
    /* Tactical palette - dark mode default */
    --tac-bg: #080a0f;
    --tac-bg-elevated: #0f131a;
    --tac-bg-hover: #161c26;
    --tac-surface: #111720;
    --tac-surface-strong: #181f2a;
    --tac-stroke: #1e2633;
    --tac-stroke-strong: #2a3444;

    /* Semantic team colors */
    --tac-radiant: #8b5cf6;   /* Attack / Radiant side */
    --tac-radiant-dim: rgba(139, 92, 246, 0.15);
    --tac-dire: #06b6d4;      /* Defense / Dire side */
    --tac-dire-dim: rgba(6, 182, 212, 0.15);
    --tac-spike: #f59e0b;     /* Economy / Spike / Warning */
    --tac-spike-dim: rgba(245, 158, 11, 0.15);
    --tac-clutch: #10b981;    /* Win / Positive */
    --tac-clutch-dim: rgba(16, 185, 129, 0.15);
    --tac-threat: #ef4444;    /* Loss / Negative */
    --tac-threat-dim: rgba(239, 68, 68, 0.15);

    /* Text */
    --tac-text: #e8eaf0;
    --tac-text-dim: #9aa3af;
    --tac-text-muted: #6b7484;
    --tac-text-inverse: #080a0f;

    /* Typography */
    --tac-font-display: "Rajdhani", "Orbitron", "Inter", sans-serif;
    --tac-font-mono: "JetBrains Mono", "Fira Code", monospace;
    --tac-font-ui: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    /* Spacing scale */
    --tac-space-1: 4px;
    --tac-space-2: 8px;
    --tac-space-3: 12px;
    --tac-space-4: 16px;
    --tac-space-5: 24px;
    --tac-space-6: 32px;
    --tac-space-7: 48px;

    /* Radii */
    --tac-r-xs: 3px;
    --tac-r-sm: 6px;
    --tac-r-md: 10px;
    --tac-r-lg: 14px;
    --tac-r-xl: 20px;

    /* Transitions */
    --tac-fast: 120ms ease;
    --tac-base: 200ms ease;
    --tac-slow: 320ms ease;

    /* Layout */
    --tac-intel-w: 280px;
    --tac-live-w: 320px;
    --tac-header-h: 64px;
    --tac-canvas-max: 1000px;
  }

  /* ==========================================================================
     BASE & LAYOUT
     ========================================================================== */
  .tac-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--tac-header-h);
    background: linear-gradient(180deg, rgba(8,10,15,1) 0%, rgba(8,10,15,0.95) 100%);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--tac-stroke);
    z-index: 100;
  }

  .tac-header__inner {
    max-width: calc(var(--tac-intel-w) + var(--tac-canvas-max) + var(--tac-live-w) + 120px);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--tac-space-5);
    gap: var(--tac-space-4);
  }

  .tac-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--tac-space-2);
    text-decoration: none;
    color: var(--tac-text);
    font-family: var(--tac-font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .tac-brand__mark {
    color: var(--tac-radiant);
    font-size: 1.1em;
  }

  .tac-brand__divider {
    color: var(--tac-text-muted);
    font-weight: 400;
  }

  .tac-brand__section {
    color: var(--tac-text-dim);
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tac-brand:hover .tac-brand__section { color: var(--tac-radiant); }

  .tac-header__meta { display: flex; align-items: center; gap: var(--tac-space-3); }

  .tac-timestamp {
    font-family: var(--tac-font-mono);
    font-size: 0.75rem;
    color: var(--tac-text-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Campana de torneos */
  .tac-notify { position: relative; }
  .tac-notify__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: var(--tac-r-md);
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    color: var(--tac-text-dim);
    cursor: pointer;
    transition: all var(--tac-fast);
  }
  .tac-notify__btn:hover, .tac-notify__btn[aria-expanded="true"] {
    background: var(--tac-bg-hover);
    border-color: var(--tac-radiant);
    color: var(--tac-radiant);
  }
  .tac-notify__btn.has-new svg { animation: tac-bell 1.6s ease-in-out 2; transform-origin: 50% 10%; }
  @keyframes tac-bell {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(14deg); }
    20%, 40% { transform: rotate(-12deg); }
  }
  .tac-notify__badge {
    position: absolute;
    top: -6px; right: -6px;
    min-width: 18px; height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--tac-threat);
    color: #fff;
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    box-shadow: 0 0 0 2px var(--tac-bg);
  }
  .tac-notify__badge[hidden] { display: none; }
  .tac-notify__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 380px;
    max-height: min(560px, calc(100vh - var(--tac-header-h) - 24px));
    display: flex;
    flex-direction: column;
    background: var(--tac-bg-elevated);
    border: 1px solid var(--tac-stroke-strong);
    border-radius: var(--tac-r-lg);
    box-shadow: 0 24px 64px rgba(0,0,0,0.55);
    z-index: 300;
    overflow: hidden;
  }
  .tac-notify__panel[hidden] { display: none; }
  .tac-notify__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--tac-space-3);
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--tac-stroke);
  }
  .tac-notify__title {
    font-family: var(--tac-font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tac-text);
  }
  .tac-notify__meta { font-family: var(--tac-font-mono); font-size: 0.6875rem; color: var(--tac-text-muted); }
  .tac-notify__list { overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 8px; }
  .tac-notify__empty { padding: 24px 12px; text-align: center; color: var(--tac-text-dim); font-size: 0.8125rem; line-height: 1.5; }
  .tac-tourney {
    padding: 12px;
    border-radius: var(--tac-r-md);
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
  }
  .tac-tourney.is-new { border-color: var(--tac-radiant); background: linear-gradient(180deg, var(--tac-radiant-dim), var(--tac-surface) 60%); }
  .tac-tourney__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
  .tac-tourney__tag {
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--tac-r-xs);
    background: var(--tac-surface-strong);
    color: var(--tac-text-dim);
  }
  .tac-tourney__tag--main { background: var(--tac-radiant-dim); color: var(--tac-radiant); }
  .tac-tourney__tag--new { background: var(--tac-radiant); color: #fff; }
  .tac-tourney__tag--soon { background: var(--tac-spike-dim); color: var(--tac-spike); }
  .tac-tourney__name { font-weight: 600; font-size: 0.9375rem; color: var(--tac-text); line-height: 1.3; overflow-wrap: anywhere; }
  .tac-tourney__org { font-size: 0.75rem; color: var(--tac-text-muted); margin-top: 2px; }
  .tac-tourney__facts { display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; margin: 10px 0; font-size: 0.75rem; }
  .tac-tourney__facts dt { color: var(--tac-text-muted); font-family: var(--tac-font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 2px; }
  .tac-tourney__facts dd { margin: 0; color: var(--tac-text); overflow-wrap: anywhere; }
  .tac-tourney__alert {
    display: flex; gap: 6px;
    margin: 0 0 10px;
    padding: 6px 8px;
    border-radius: var(--tac-r-sm);
    background: var(--tac-spike-dim);
    color: var(--tac-spike);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .tac-tourney__cta {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px;
    border-radius: var(--tac-r-sm);
    background: var(--tac-radiant);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: filter var(--tac-fast);
  }
  .tac-tourney__cta:hover { filter: brightness(1.15); }
  .tac-notify__foot {
    padding: 10px 16px 12px;
    border-top: 1px solid var(--tac-stroke);
    font-size: 0.6875rem;
    color: var(--tac-text-muted);
    line-height: 1.5;
  }
  .tac-notify__foot strong { color: var(--tac-text-dim); font-weight: 600; }
  .tac-notify__foot details { margin-top: 4px; }
  .tac-notify__foot summary { cursor: pointer; color: var(--tac-text-dim); }
  .tac-header-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: var(--tac-r-md);
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    color: var(--tac-text-dim);
    cursor: pointer;
    transition: all var(--tac-fast);
  }
  .tac-header-btn:hover, .tac-header-btn[aria-expanded="true"] { border-color: var(--tac-radiant); color: var(--tac-radiant); }

  .tac-main {
    margin-top: var(--tac-header-h);
    min-height: calc(100vh - var(--tac-header-h));
    background: var(--tac-bg);
    color: var(--tac-text);
    font-family: var(--tac-font-ui);
  }

  .tac-layout {
    display: grid;
    grid-template-columns: var(--tac-intel-w) minmax(0, 1fr) var(--tac-live-w);
    grid-template-rows: 1fr;
    min-height: calc(100vh - var(--tac-header-h));
    max-width: calc(var(--tac-intel-w) + var(--tac-canvas-max) + var(--tac-live-w) + 80px);
    margin: 0 auto;
    gap: 0;
  }

  /* ==========================================================================
     INTEL RAIL (Left)
     ========================================================================== */
  .tac-intel {
    position: sticky;
    top: var(--tac-header-h);
    height: calc(100vh - var(--tac-header-h));
    background: var(--tac-bg-elevated);
    border-right: 1px solid var(--tac-stroke);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 50;
  }

  .tac-tabs {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--tac-space-4) var(--tac-space-3);
    padding-bottom: var(--tac-space-6);
    border-bottom: 1px solid var(--tac-stroke);
  }

  .tac-tab {
    display: flex;
    align-items: center;
    gap: var(--tac-space-3);
    width: 100%;
    padding: var(--tac-space-3) var(--tac-space-4);
    border-radius: var(--tac-r-md);
    background: transparent;
    border: 1px solid transparent;
    color: var(--tac-text-dim);
    font-family: var(--tac-font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all var(--tac-fast);
    margin-bottom: var(--tac-space-1);
  }
  .tac-tab:hover {
    background: var(--tac-bg-hover);
    color: var(--tac-text);
    border-color: var(--tac-stroke);
  }
  .tac-tab[aria-selected="true"] {
    background: var(--tac-radiant-dim);
    border-color: rgba(139, 92, 246, 0.3);
    color: var(--tac-radiant);
  }
  .tac-tab__avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--tac-font-display);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--tac-text-dim);
    flex-shrink: 0;
    overflow: hidden;
  }
  .tac-tab[aria-selected="true"] .tac-tab__avatar {
    background: var(--tac-radiant);
    border-color: var(--tac-radiant);
    color: #fff;
  }
  .tac-tab__icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--tac-text-muted); }
  .tac-tab[aria-selected="true"] .tac-tab__icon { color: var(--tac-radiant); }

  .tac-filters {
    padding: var(--tac-space-4) var(--tac-space-3);
    border-bottom: 1px solid var(--tac-stroke);
  }

  .tac-filter-group {
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    padding: var(--tac-space-4);
    margin: 0;
    overflow: hidden;
  }
  .tac-filter-group + .tac-filter-group { margin-top: var(--tac-space-4); }

  .tac-filter-label {
    display: block;
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tac-text-muted);
    margin-bottom: var(--tac-space-3);
  }

  /* Segmented control for modes */
  .tac-segmented { display: flex; flex-direction: column; gap: var(--tac-space-1); }
  .tac-segment { position: relative; }
  .tac-segment input { position: absolute; inset: 0; opacity: 0; pointer-events: none; cursor: pointer; }
  .tac-segment__content {
    display: flex;
    align-items: center;
    gap: var(--tac-space-2);
    width: 100%;
    padding: var(--tac-space-2) var(--tac-space-3);
    border-radius: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--tac-stroke);
    color: var(--tac-text-dim);
    font-family: var(--tac-font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--tac-fast);
  }
  .tac-segment__content:last-child { border-bottom: none; }
  .tac-segment__content:hover {
    background: var(--tac-bg-hover);
    color: var(--tac-text);
  }
  .tac-segment input:checked + .tac-segment__content {
    background: var(--tac-radiant-dim);
    color: var(--tac-radiant);
  }
  .tac-segment__icon { flex-shrink: 0; opacity: 0.7; }
  .tac-segment input:checked + .tac-segment__content .tac-segment__icon { opacity: 1; color: var(--tac-radiant); }
  .tac-segment__badge {
    margin-left: auto;
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--tac-radiant);
    color: #fff;
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-align: center;
    opacity: 0;
    transform: scale(0.8);
    transition: all var(--tac-fast);
  }
  .tac-segment input:checked + .tac-segment__content .tac-segment__badge { opacity: 1; transform: scale(1); }
  .tac-segment__badge:empty { display: none; }

  /* Toggle for period */
  .tac-toggle { display: flex; background: var(--tac-surface); border-radius: var(--tac-r-sm); border: 1px solid var(--tac-stroke); overflow: hidden; }
  .tac-toggle input { position: absolute; inset: 0; opacity: 0; pointer-events: none; cursor: pointer; }
  .tac-toggle__btn {
    flex: 1;
    padding: var(--tac-space-2) var(--tac-space-3);
    background: transparent;
    border: 0;
    color: var(--tac-text-dim);
    font-family: var(--tac-font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--tac-fast);
    white-space: nowrap;
  }
  .tac-toggle input:checked + .tac-toggle__btn {
    background: var(--tac-radiant);
    color: #fff;
  }
  .tac-toggle__btn:hover { color: var(--tac-text); }
  .tac-toggle input:checked + .tac-toggle__btn:hover { color: #fff; }

  /* ==========================================================================
     CANVAS (Center)
     ========================================================================== */
  .tac-canvas {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--tac-space-6) var(--tac-space-5);
    max-width: var(--tac-canvas-max);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .tac-canvas__header { margin-bottom: var(--tac-space-6); padding-bottom: var(--tac-space-4); border-bottom: 1px solid var(--tac-stroke); }
  .tac-canvas__title {
    font-family: var(--tac-font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.03em;
    color: var(--tac-text);
    margin: 0 0 var(--tac-space-1);
    line-height: 1.1;
  }
  .tac-canvas__subtitle {
    font-family: var(--tac-font-mono);
    font-size: 0.8125rem;
    color: var(--tac-text-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .tac-canvas__body { flex: 1; min-width: 0; }

  /* ==========================================================================
     LIVE PANEL (Right)
     ========================================================================== */
  .tac-live {
    position: sticky;
    top: var(--tac-header-h);
    height: calc(100vh - var(--tac-header-h));
    background: var(--tac-bg-elevated);
    border-left: 1px solid var(--tac-stroke);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 40;
  }
  .tac-live[hidden] { display: none; }

  .tac-live__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--tac-space-4) var(--tac-space-4);
    border-bottom: 1px solid var(--tac-stroke);
  }
  .tac-live__title {
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--tac-radiant);
  }
  .tac-live__close {
    display: none;
    width: 32px; height: 32px;
    border-radius: var(--tac-r-sm);
    background: transparent;
    border: 1px solid var(--tac-stroke);
    color: var(--tac-text-dim);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: all var(--tac-fast);
  }
  .tac-live__close:hover { background: var(--tac-bg-hover); border-color: var(--tac-threat); color: var(--tac-threat); }

  .tac-live__body { flex: 1; overflow-y: auto; padding: var(--tac-space-4); }

  /* ==========================================================================
     COMPONENTS: KPI STRIP
     ========================================================================== */
  .tac-kpi-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--tac-space-3);
    margin-bottom: var(--tac-space-5);
  }
  .tac-kpi {
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    padding: var(--tac-space-4);
    transition: all var(--tac-base);
  }
  .tac-kpi:hover { border-color: var(--tac-stroke-strong); transform: translateY(-2px); }
  .tac-kpi--radiant { border-left: 3px solid var(--tac-radiant); }
  .tac-kpi--dire { border-left: 3px solid var(--tac-dire); }
  .tac-kpi--spike { border-left: 3px solid var(--tac-spike); }
  .tac-kpi--clutch { border-left: 3px solid var(--tac-clutch); }
  .tac-kpi--threat { border-left: 3px solid var(--tac-threat); }

  .tac-kpi__label {
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tac-text-muted);
    margin-bottom: var(--tac-space-1);
  }
  .tac-kpi__value {
    font-family: var(--tac-font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--tac-text);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .tac-kpi__trend {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: var(--tac-space-1);
    font-family: var(--tac-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .tac-kpi__trend--up { color: var(--tac-clutch); }
  .tac-kpi__trend--down { color: var(--tac-threat); }
  .tac-kpi__trend--neutral { color: var(--tac-text-muted); }

  /* ==========================================================================
     COMPONENTS: SCOREBOARD TABLES
     ========================================================================== */
  .tac-scoreboard {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    overflow: hidden;
  }
  .tac-scoreboard thead {
    background: var(--tac-bg-elevated);
    border-bottom: 1px solid var(--tac-stroke);
  }
  .tac-scoreboard th {
    padding: var(--tac-space-3) var(--tac-space-4);
    text-align: left;
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tac-text-muted);
    white-space: nowrap;
    cursor: default;
  }
  .tac-scoreboard th.sortable {
    cursor: pointer;
    user-select: none;
  }
  .tac-scoreboard th.sortable:hover { color: var(--tac-radiant); }
  .tac-scoreboard th[aria-sort="ascending"],
  .tac-scoreboard th[aria-sort="descending"] { color: var(--tac-radiant); }
  .tac-scoreboard th.num { text-align: right; }
  .tac-scoreboard th.center { text-align: center; }

  .tac-scoreboard td {
    padding: var(--tac-space-3) var(--tac-space-4);
    border-bottom: 1px solid var(--tac-stroke);
    vertical-align: middle;
    transition: background var(--tac-fast);
  }
  .tac-scoreboard tbody tr:last-child td { border-bottom: 0; }
  .tac-scoreboard tbody tr:hover td { background: var(--tac-bg-hover); }
  .tac-scoreboard td.num { text-align: right; font-family: var(--tac-font-mono); font-variant-numeric: tabular-nums; }
  .tac-scoreboard td.center { text-align: center; }

  /* Row types */
  .tac-scoreboard tr.tac-row--win td { border-left: 3px solid var(--tac-clutch); }
  .tac-scoreboard tr.tac-row--loss td { border-left: 3px solid var(--tac-threat); }
  .tac-scoreboard tr.tac-row--draw td { border-left: 3px solid var(--tac-spike); }
  .tac-scoreboard tr.tac-row--expandable { cursor: pointer; }
  .tac-scoreboard tr.tac-row--expandable:hover td { background: var(--tac-radiant-dim); }

  /* Team colored rows */
  .tac-scoreboard tr.tac-side--radiant td { background: var(--tac-radiant-dim); }
  .tac-scoreboard tr.tac-side--dire td { background: var(--tac-dire-dim); }

  /* Round dots */
  .tac-rounds { display: inline-flex; gap: 3px; align-items: center; font-family: var(--tac-font-mono); font-size: 0.7rem; }
  .tac-rounds__total { margin-left: var(--tac-space-2); white-space: nowrap; }
  .tac-round { width: 8px; height: 8px; border-radius: 50%; background: var(--tac-stroke); flex-shrink: 0; }
  .tac-round--win { background: var(--tac-clutch); }
  .tac-round--loss { background: var(--tac-threat); }
  .tac-round--win.tac-round--atk { box-shadow: 0 0 0 2px var(--tac-radiant-dim); }
  .tac-round--win.tac-round--def { box-shadow: 0 0 0 2px var(--tac-dire-dim); }

  /* Badges */
  .tac-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--tac-r-xs);
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tac-badge--premier { background: var(--tac-radiant-dim); color: var(--tac-radiant); border: 1px solid rgba(139,92,246,0.3); }
  .tac-badge--custom { background: var(--tac-dire-dim); color: var(--tac-dire); border: 1px solid rgba(6,182,212,0.3); }
  .tac-badge--competitive { background: var(--tac-spike-dim); color: var(--tac-spike); border: 1px solid rgba(245,158,11,0.3); }
  .tac-badge--torneo { background: var(--tac-clutch-dim); color: var(--tac-clutch); border: 1px solid rgba(16,185,129,0.3); }
  .tac-badge--scrim { background: var(--tac-stroke); color: var(--tac-text-dim); border: 1px solid var(--tac-stroke-strong); }
  .tac-badge--sub { background: var(--tac-spike-dim); color: var(--tac-spike); border: 1px solid rgba(245,158,11,0.3); font-size: 0.5625rem; }

  /* Agent pill */
  .tac-agent { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px 2px 6px; border-radius: var(--tac-r-sm); background: var(--tac-bg-elevated); border: 1px solid var(--tac-stroke); font-size: 0.75rem; font-weight: 500; color: var(--tac-text); white-space: nowrap; }
  .tac-agent__icon { width: 18px; height: 18px; border-radius: 3px; object-fit: cover; }
  .tac-agent--fallback { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 3px; font-family: var(--tac-font-display); font-weight: 700; font-size: 0.5625rem; color: #fff; }

  /* Player link */
  .tac-player { color: var(--tac-text); font-weight: 500; text-decoration: none; transition: color var(--tac-fast); }
  .tac-player:hover { color: var(--tac-radiant); }

  /* Win/Loss text */
  .tac-win { color: var(--tac-clutch); font-weight: 600; }
  .tac-loss { color: var(--tac-threat); font-weight: 600; }
  .tac-draw { color: var(--tac-spike); font-weight: 600; }

  /* Leader highlight */
  .tac-leader { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 24px; padding: 0 6px; border-radius: var(--tac-r-xs); background: var(--tac-radiant); color: #fff; font-family: var(--tac-font-mono); font-size: 0.625rem; font-weight: 700; }

  /* Detail row */
  .tac-detail-row td { padding: 0 !important; border: 0 !important; background: var(--tac-bg-elevated) !important; }
  .tac-detail-panel { padding: var(--tac-space-4); border-top: 1px solid var(--tac-stroke); animation: tac-slide-down var(--tac-base); }
  @keyframes tac-slide-down { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

  /* ==========================================================================
     COMPONENTS: COMPOSITION CARDS
     ========================================================================== */
  .tac-compositions { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--tac-space-3); margin-top: var(--tac-space-3); }
  .tac-comp-card {
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    padding: var(--tac-space-4);
    transition: all var(--tac-base);
  }
  .tac-comp-card:hover { border-color: var(--tac-stroke-strong); transform: translateY(-2px); }
  .tac-comp-card__map { font-family: var(--tac-font-mono); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tac-text-muted); margin-bottom: var(--tac-space-2); }
  .tac-comp-card__agents { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--tac-space-3); }
  .tac-comp-card__agent { width: 36px; height: 36px; border-radius: var(--tac-r-sm); object-fit: cover; border: 1px solid var(--tac-stroke); background: var(--tac-bg-elevated); }
  .tac-comp-card__stats { display: flex; justify-content: space-between; align-items: center; padding-top: var(--tac-space-3); border-top: 1px solid var(--tac-stroke); }
  .tac-comp-card__record { font-family: var(--tac-font-display); font-weight: 700; font-size: 1.125rem; color: var(--tac-text); }
  .tac-comp-card__wr { font-family: var(--tac-font-mono); font-size: 0.875rem; font-weight: 600; }
  .tac-comp-card__wr--pos { color: var(--tac-clutch); }
  .tac-comp-card__wr--neg { color: var(--tac-threat); }
  .tac-comp-card__wr--neu { color: var(--tac-text-dim); }

  /* ==========================================================================
     COMPONENTS: ELO TIMELINE (Step Chart)
     ========================================================================== */
  .tac-elo-timeline { position: relative; height: 200px; background: var(--tac-bg-elevated); border: 1px solid var(--tac-stroke); border-radius: var(--tac-r-md); }
  .tac-elo-timeline svg { width: 100%; height: 100%; display: block; }
  .tac-elo-timeline .tier-band { fill-opacity: 0.08; }
  .tac-elo-timeline .tier-label { font-family: var(--tac-font-mono); font-size: 0.5625rem; fill: var(--tac-text-muted); text-anchor: end; dominant-baseline: middle; }
  .tac-elo-timeline .elo-path { fill: none; stroke: var(--tac-radiant); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .tac-elo-timeline .elo-point { stroke: var(--tac-bg); stroke-width: 2; }
  .tac-elo-timeline .elo-point:hover { stroke-width: 3; cursor: pointer; opacity: 0.9; }
  .tac-elo-timeline .date-axis { font-family: var(--tac-font-mono); font-size: 0.625rem; fill: var(--tac-text-muted); }
  .tac-elo-timeline .rr-delta { font-family: var(--tac-font-mono); font-size: 0.5rem; pointer-events: none; opacity: 0.8; }
  .tac-elo-timeline .anchor-label { font-family: var(--tac-font-mono); font-size: 0.5625rem; font-weight: 600; pointer-events: none; }

  /* Tooltip for ELO timeline */
  .tac-elo-tooltip {
    position: absolute;
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    padding: var(--tac-space-3);
    font-size: 0.8125rem;
    color: var(--tac-text);
    pointer-events: none;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    min-width: 140px;
  }
  .tac-elo-tooltip[hidden] { display: none; }
  .tac-elo-tooltip__date {
    font-family: var(--tac-font-mono);
    font-size: 0.625rem;
    color: var(--tac-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--tac-space-1);
    border-bottom: 1px solid var(--tac-stroke);
    padding-bottom: var(--tac-space-1);
  }
  .tac-elo-tooltip__rank {
    font-family: var(--tac-font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--tac-text);
    margin-bottom: var(--tac-space-1);
  }
  .tac-elo-tooltip__rr {
    font-family: var(--tac-font-mono);
    font-size: 0.75rem;
    color: var(--tac-text-dim);
  }

  /* ==========================================================================
     COMPONENTS: CALLOUTS / HIGHLIGHTS
     ========================================================================== */
  .tac-callouts { display: flex; flex-direction: column; gap: var(--tac-space-2); margin-bottom: var(--tac-space-4); }
  .tac-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--tac-space-3);
    padding: var(--tac-space-3) var(--tac-space-4);
    border-radius: var(--tac-r-md);
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .tac-callout__icon { flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px; }
  .tac-callout--map { border-left: 3px solid var(--tac-radiant); }
  .tac-callout--map .tac-callout__icon { color: var(--tac-radiant); }
  .tac-callout--trend { border-left: 3px solid var(--tac-spike); }
  .tac-callout--trend .tac-callout__icon { color: var(--tac-spike); }
  .tac-callout--agent { border-left: 3px solid var(--tac-dire); }
  .tac-callout--agent .tac-callout__icon { color: var(--tac-dire); }

  /* ==========================================================================
     COMPONENTS: SECTION HEADERS
     ========================================================================== */
  .tac-section { margin-top: var(--tac-space-6); }
  .tac-section:first-child { margin-top: 0; }
  .tac-section__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--tac-space-3); }
  .tac-section__title {
    font-family: var(--tac-font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--tac-text);
    letter-spacing: -0.01em;
  }
  .tac-section__count { font-family: var(--tac-font-mono); font-size: 0.75rem; color: var(--tac-text-muted); }

  /* ==========================================================================
     COMPONENTS: MAP DETAIL GRID
     ========================================================================== */
  .tac-map-detail { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--tac-space-3); }
  .tac-map-player {
    background: var(--tac-surface);
    border: 1px solid var(--tac-stroke);
    border-radius: var(--tac-r-md);
    padding: var(--tac-space-3);
    text-align: center;
  }
  .tac-map-player__name { font-family: var(--tac-font-ui); font-weight: 600; font-size: 0.8125rem; color: var(--tac-text); margin-bottom: var(--tac-space-1); }
  .tac-map-player__agent { font-family: var(--tac-font-mono); font-size: 0.7rem; color: var(--tac-text-dim); margin-bottom: var(--tac-space-2); }
  .tac-map-player__stats { display: flex; justify-content: center; gap: var(--tac-space-4); }
  .tac-map-player__stat { display: flex; flex-direction: column; gap: 2px; }
  .tac-map-player__stat-label { font-family: var(--tac-font-mono); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tac-text-muted); }
  .tac-map-player__stat-value { font-family: var(--tac-font-display); font-weight: 700; font-size: 1rem; color: var(--tac-text); }

  /* ==========================================================================
     COMPONENTS: MATCH CARDS
     ========================================================================== */
  .tac-match-section { margin-top: var(--tac-space-6); }
  .tac-match-filters { display: flex; gap: var(--tac-space-2); flex-wrap: wrap; margin-bottom: var(--tac-space-4); padding-bottom: var(--tac-space-3); border-bottom: 1px solid var(--tac-stroke); }
  .tac-match-filter { padding: var(--tac-space-1) var(--tac-space-3); border: 1px solid var(--tac-stroke); border-radius: var(--tac-r-full); background: var(--tac-bg); color: var(--tac-text-dim); font-size: 0.6875rem; font-family: var(--tac-font-mono); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: all var(--tac-base); max-width: 100%; }
  .tac-match-filter:hover, .tac-match-filter:focus-visible { border-color: var(--tac-radiant); color: var(--tac-text); outline: none; }
  .tac-match-filter:disabled { opacity: 0.5; cursor: default; }
  .tac-match-filter option { background: var(--tac-bg-elevated); color: var(--tac-text); text-transform: none; }
  .tac-match-filter__count { font-size: 0.625rem; opacity: 0.7; }
  .tac-nowrap { white-space: nowrap; }
  .tac-idle { display: inline-flex; flex-direction: column; gap: 2px; line-height: 1.2; white-space: nowrap; }
  .tac-idle__ago { font-weight: 600; color: var(--tac-text); }
  .tac-idle__when { font-family: var(--tac-font-mono); font-size: 0.6875rem; color: var(--tac-text-muted); }
  .tac-idle--warn .tac-idle__ago { color: var(--tac-spike); }
