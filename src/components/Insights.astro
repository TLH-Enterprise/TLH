---
const posts = [
  {
    category: "Perspective",
    title: "Del prototipo a producción: cómo minimizar riesgo sin frenar velocidad",
    date: "2026-04-07",
    excerpt:
      "Una guía práctica para decidir qué validar primero, cómo instrumentar métricas y cuándo invertir en arquitectura.",
  },
  {
    category: "Engineering",
    title: "Core Web Vitals como estándar: performance que sí se sostiene",
    date: "2026-04-07",
    excerpt:
      "Patrones y checklist para mantener CWV alto en el tiempo: imágenes, caching, bundles y observabilidad.",
  },
  {
    category: "AI",
    title: "Automatización con IA: dónde aporta valor y dónde no",
    date: "2026-04-07",
    excerpt:
      "Casos comunes (y anti‑patrones) al integrar copilots, RAG y automatizaciones en operaciones reales.",
  },
];
---

<section class="insights section" aria-label="Insights" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Insights</div>
      <h2 class="h2">
        Perspectivas para tomar mejores decisiones en
        <span class="gradient-text">producto y tecnología</span>
      </h2>
      <p class="lead">
        Ideas accionables sobre delivery, performance y ejecución. (Podemos
        conectarlo a un CMS cuando quieras.)
      </p>
    </div>

    <div class="insights-grid" data-reveal>
      {
        posts.map((p) => (
          <article class="insight card card-hover" data-tilt="3">
            <div class="meta">
              <span class="cat">{p.category}</span>
              <span class="dot" aria-hidden="true"></span>
              <time class="date" datetime={p.date}>
                {new Date(p.date).toLocaleDateString("es-CO", {
                  year: "numeric",
                  month: "short",
                  day: "2-digit",
                })}
              </time>
            </div>

            <h3 class="title">{p.title}</h3>
            <p class="excerpt">{p.excerpt}</p>

            <div class="read">
              <span>Leer más</span>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .insights {
    position: relative;
  }

  .insights::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
        1000px 520px at 20% 30%,
        rgba(139, 92, 246, 0.1) 0%,
        transparent 62%
      ),
      radial-gradient(
        900px 520px at 85% 70%,
        rgba(34, 211, 238, 0.05) 0%,
        transparent 60%
      );
    z-index: 0;
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .insight {
    padding: 1.5rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    min-height: 260px;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.62);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  .cat {
    color: rgba(167, 139, 250, 0.95);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
  }

  .date {
    color: rgba(255, 255, 255, 0.56);
  }

  .title {
    margin: 0.85rem 0 0;
    font-weight: 820;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .excerpt {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
    font-size: 1rem;
  }

  .read {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.25rem;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .arrow {
    transition: transform 0.22s ease;
  }

  .insight:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .insights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

