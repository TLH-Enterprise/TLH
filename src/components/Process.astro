---
const processSteps = [
  {
    number: "01",
    title: "Descubrimiento",
    description:
      "Analizamos tus necesidades, objetivos y audiencia objetivo para crear una estrategia sólida.",
    details: [
      "Reunión inicial",
      "Análisis de competencia",
      "Definición de objetivos",
      "Investigación de usuarios",
    ],
    icon: "🔍",
  },
  {
    number: "02",
    title: "Planificación",
    description:
      "Desarrollamos un plan detallado con cronogramas, recursos y metodologías específicas para tu proyecto.",
    details: [
      "Arquitectura de información",
      "Wireframes y prototipos",
      "Plan de desarrollo",
      "Cronograma de entregas",
    ],
    icon: "📋",
  },
  {
    number: "03",
    title: "Diseño",
    description:
      "Creamos diseños visuales atractivos y funcionales que reflejan la identidad de tu marca.",
    details: [
      "Diseño de interfaz",
      "Sistema de diseño",
      "Prototipos interactivos",
      "Revisión y feedback",
    ],
    icon: "🎨",
  },
  {
    number: "04",
    title: "Desarrollo",
    description:
      "Implementamos la solución técnica utilizando las mejores prácticas y tecnologías modernas.",
    details: [
      "Desarrollo frontend",
      "Desarrollo backend",
      "Integración de APIs",
      "Testing y QA",
    ],
    icon: "⚡",
  },
  {
    number: "05",
    title: "Lanzamiento",
    description:
      "Desplegamos tu proyecto en producción con monitoreo continuo y soporte técnico.",
    details: [
      "Deploy a producción",
      "Configuración de servidores",
      "Monitoreo de performance",
      "Capacitación del equipo",
    ],
    icon: "🚀",
  },
  {
    number: "06",
    title: "Mantenimiento",
    description:
      "Ofrecemos soporte continuo, actualizaciones y mejoras para mantener tu proyecto actualizado.",
    details: [
      "Soporte técnico",
      "Actualizaciones de seguridad",
      "Mejoras de performance",
      "Nuevas funcionalidades",
    ],
    icon: "🔧",
  },
];
---

<section id="proceso" class="process section section--split">
  <div class="container">
    <div class="section-header">
      <div class="kicker">How we work</div>
      <h2 class="h2">
        Un proceso claro para reducir riesgo y
        <span class="gradient-text">acelerar resultados</span>
      </h2>
      <p class="lead">
        Metodología probada, comunicación constante y entregas iterativas.
      </p>
    </div>

    <div class="process-timeline">
      {
        processSteps.map((step, index) => (
          <div class={`process-step ${index % 2 === 0 ? "left" : "right"}`}>
            <div class="step-content card card-hover">
              <div class="step-number">{step.number}</div>
              <div class="step-icon">
                <span class="icon">{step.icon}</span>
              </div>
              <div class="step-info">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-description">{step.description}</p>
                <ul class="step-details">
                  {step.details.map((detail) => (
                    <li class="detail-item">{detail}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="process-cta">
      <div class="cta-content card">
        <h3>¿Listo para comenzar tu proyecto?</h3>
        <p>
          Contáctanos y descubre cómo podemos ayudarte a alcanzar tus objetivos
        </p>
        <div class="cta-buttons">
          <a href="#contacto" class="btn btn-primary">Iniciar Proyecto</a>
          <!--a href="#portafolio" class="btn btn-secondary">Ver Casos de Éxito</a>-->
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: hidden;
  }

  .process::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background: radial-gradient(
        900px 520px at 20% 20%,
        rgba(139, 92, 246, 0.12) 0%,
        transparent 60%
      ),
      radial-gradient(
        800px 520px at 80% 80%,
        rgba(34, 211, 238, 0.06) 0%,
        transparent 60%
      );
    z-index: 0;
  }

  /* Codigo de la linea central
  .process-timeline {
    position: relative;
    margin: 4rem 0;
  }

  .process-timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
    transform: translateX(-50%);
    z-index: 1;
  }*/

  .process-step {
    display: flex;
    margin-bottom: 4rem;
    position: relative;
  }

  .process-step.left {
    justify-content: flex-start;
  }

  .process-step.right {
    justify-content: flex-end;
  }

  .step-content {
    padding: 2.5rem;
    width: 45%;
    position: relative;
  }

  .step-number {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.95) 0%, rgba(109, 40, 217, 0.95) 70%, rgba(34, 211, 238, 0.35) 140%);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    z-index: 2;
  }

  .step-icon {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .icon {
    font-size: 3rem;
    display: inline-block;
    filter: drop-shadow(0 12px 30px rgba(139, 92, 246, 0.22));
  }

  .step-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem 0;
    text-align: center;
  }

  .step-description {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .step-details {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-item {
    color: rgba(255, 255, 255, 0.72);
    padding: 0.5rem 0;
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9rem;
  }

  .detail-item::before {
    content: "→";
    position: absolute;
    left: 0;
    color: rgba(167, 139, 250, 0.95);
    font-weight: bold;
  }

  .process-cta {
    text-align: center;
    margin-top: 4rem;
    padding: 3rem;
  }

  .cta-content {
    padding: 3rem;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cta-content h3 {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.1rem;
    margin: 0 0 2rem 0;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .process-step {
      justify-content: center !important;
      margin-left: 0;
      margin-bottom: 3rem;
    }

    .step-content {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    .step-number {
      left: 50%;
      transform: translateX(-50%);
    }

    .process-cta {
      padding: 0;
    }

    .cta-content {
      padding: 2rem;
    }

    .cta-content h3 {
      font-size: 1.5rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .step-content {
      padding: 2rem;
      max-width: 100%;
    }

    .icon {
      font-size: 2.5rem;
    }

    .step-title {
      font-size: 1.3rem;
    }

    .step-number {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
