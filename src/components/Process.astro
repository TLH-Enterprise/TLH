---
const processSteps = [
  {
    number: "01",
    title: "Descubrimiento",
    description:
      "Entendemos tu negocio, tus objetivos y tu audiencia antes de proponer cualquier solución.",
    details: [
      "Reunión inicial y levantamiento de contexto",
      "Análisis de competencia",
      "Definición de objetivos y alcance",
    ],
  },
  {
    number: "02",
    title: "Planificación",
    description:
      "Definimos un plan con cronograma, responsables y entregables verificables para cada etapa.",
    details: [
      "Arquitectura de información",
      "Plan de desarrollo y recursos",
      "Cronograma de entregas",
    ],
  },
  {
    number: "03",
    title: "Diseño",
    description:
      "Diseñamos interfaces claras y consistentes que reflejan la identidad de tu marca.",
    details: [
      "Diseño de interfaz y sistema de diseño",
      "Prototipos interactivos",
      "Revisión y feedback contigo",
    ],
  },
  {
    number: "04",
    title: "Desarrollo",
    description:
      "Construimos con buenas prácticas de ingeniería, calidad de código y entregas iterativas.",
    details: [
      "Desarrollo frontend y backend",
      "Integración de APIs",
      "Testing y aseguramiento de calidad",
    ],
  },
  {
    number: "05",
    title: "Lanzamiento",
    description:
      "Desplegamos a producción con monitoreo, documentación y acompañamiento a tu equipo.",
    details: [
      "Despliegue a producción",
      "Monitoreo de performance",
      "Capacitación del equipo",
    ],
  },
  {
    number: "06",
    title: "Evolución",
    description:
      "Acompañamos la operación con soporte, mejoras continuas y nuevas funcionalidades.",
    details: [
      "Soporte técnico y actualizaciones",
      "Mejoras de performance",
      "Nuevas funcionalidades",
    ],
  },
] as const;
---

<section id="proceso" class="process section section--split" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Metodología</div>
      <h2 class="h2">
        Un proceso claro para reducir riesgo y
        <span class="gradient-text">acelerar resultados</span>
      </h2>
      <p class="lead">
        Trabajamos con etapas definidas, comunicación constante y entregas
        iterativas que puedes revisar en cada paso.
      </p>
    </div>

    <div class="process-grid" data-reveal>
      {
        processSteps.map((step) => (
          <div class="process-step card">
            <div class="step-number">{step.number}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
            <ul class="step-details">
              {step.details.map((detail) => (
                <li class="detail-item">{detail}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .process-step {
    padding: 1.75rem;
  }

  .step-number {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-1);
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.85rem;
    margin-bottom: 1.1rem;
    border-bottom: 2px solid var(--brand-1);
    width: fit-content;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.015em;
    margin: 0 0 0.6rem 0;
  }

  .step-description {
    color: var(--text-2);
    line-height: 1.6;
    margin: 0 0 1rem 0;
    font-size: 0.98rem;
  }

  .step-details {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-item {
    color: var(--text-3);
    padding: 0.3rem 0 0.3rem 1.15rem;
    position: relative;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .detail-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.85rem;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--brand-1);
  }

  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
