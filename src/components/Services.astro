---
import Icon from "./Icon.astro";

const businessLines = [
  {
    number: "01",
    icon: "rocket",
    title: "Desarrollo de software",
    description:
      "Diseñamos y construimos software a la medida: desde aplicaciones web y móviles hasta soluciones empresariales e integraciones con IA.",
    features: [
      "Aplicaciones web y móviles (React, Astro, React Native, Flutter)",
      "Soluciones empresariales: ERP, CRM, BPM e integraciones con sistemas legados",
      "IA y automatización: chatbots, RPA, modelos de predicción e IA generativa",
      "Diseño UX/UI: research, prototipado y design systems",
    ],
  },
  {
    number: "02",
    icon: "wrench",
    title: "Consultoría y outsourcing TI",
    description:
      "Acompañamos a las empresas en su estrategia tecnológica y ampliamos sus equipos con talento senior cuando lo necesitan.",
    features: [
      "Equipos extendidos (staff augmentation)",
      "Consultoría en transformación digital, arquitectura y DevOps",
      "Gestión de proyectos de software end-to-end",
      "Soporte, mantenimiento y evolución de plataformas",
    ],
  },
  {
    number: "03",
    icon: "megaphone",
    title: "Marketing y growth",
    description:
      "Estrategia y ejecución para que tu producto no solo exista: que se posicione, se entienda y convierta.",
    features: [
      "Estrategia de lanzamiento y posicionamiento",
      "Landing pages orientadas a conversión",
      "Campañas, creatividades y pauta",
      "Analytics, experimentación y A/B testing",
    ],
  },
  {
    number: "04",
    icon: "camera",
    title: "Filmmaking y contenido",
    description:
      "Producción audiovisual con estándar profesional: video, piezas para campañas y storytelling alineado a tu marca.",
    features: [
      "Producción y edición de video",
      "Motion graphics para redes y campañas",
      "Brand storytelling",
      "Contenido para ads y lanzamientos",
    ],
  },
] as const;
---

<section id="servicios" class="services section section--dark" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Líneas de negocio</div>
      <h2 class="h2">
        Cuatro disciplinas para construir y hacer crecer
        <span class="gradient-text">productos digitales</span>
      </h2>
      <p class="lead">
        Cubrimos el ciclo completo: estrategia, construcción, lanzamiento y
        crecimiento, con un mismo equipo responsable de principio a fin.
      </p>
    </div>

    <div class="services-grid" data-reveal data-stagger>
      {
        businessLines.map((line) => (
          <div class="service-card card card-hover" data-spotlight>
            <div class="service-head">
              <span class="service-icon" aria-hidden="true">
                <Icon name={line.icon} size={22} />
              </span>
              <span class="service-number">{line.number}</span>
            </div>
            <h3 class="service-title">{line.title}</h3>
            <p class="service-description">{line.description}</p>
            <ul class="service-features">
              {line.features.map((feature) => (
                <li class="feature-item">{feature}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    padding: 2.25rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
  }

  /* Cursor spotlight */
  .service-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 0%),
      rgba(167, 139, 250, 0.16),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .service-card:hover::after {
    opacity: 1;
  }

  .service-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .service-title,
  .service-description,
  .service-features {
    position: relative;
    z-index: 1;
  }

  .service-title {
    font-family: var(--font-display);
  }

  .service-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--r-sm);
    color: var(--brand-1);
    background: var(--brand-3);
  }

  .service-number {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .service-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-1);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.015em;
  }

  .service-description {
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 1.25rem 0;
  }

  .service-features {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--stroke-1);
  }

  .feature-item {
    color: var(--text-2);
    padding: 0.6rem 0 0.6rem 1.4rem;
    position: relative;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .feature-item + .feature-item {
    border-top: 1px solid var(--stroke-1);
  }

  .feature-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--brand-1);
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .service-card {
      padding: 1.75rem;
    }
  }
</style>
