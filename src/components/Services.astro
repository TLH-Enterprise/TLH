---
import Icon from "./Icon.astro";

const services = [
  {
    icon: "rocket",
    title: "Desarollo de software a la medida",
    description:
      "Creamos soluciones software a la medida para satisfacer las necesidades de tu negocio.",
    features: [
      "Aplicaciones web personalizadas",
      "Soluciones empresariales (ERP, CRM, BPM, etc.)",
      "Integraciones con APIs y sistemas legados",
    ],
  },
  {
    icon: "mobile",
    title: "Desarrollo web y de aplicaciones móviles",
    description:
      "Desarrollamos aplicaciones móviles nativas e híbridas que conectan con tus usuarios en cualquier dispositivo.",
    features: ["React, Vue, Astro", "React Native", "Flutter", "PWA"],
  },
  {
    icon: "spark",
    title: "Inteligencia Artificial y Automatización",
    description:
      "Implementamos soluciones de IA y automatización para optimizar procesos y aumentar la eficiencia de tu negocio.",
    features: [
      "Chatbots",
      "Automatización de procesos",
      "Asistentes virtuales",
      "RPA",
      "Modelos de predicción",
      "Análisis de datos",
      "Sistemas de recomendación e IA generativa",
      "Y mucho más...",
    ],
  },
  {
    icon: "palette",
    title: "Diseño UX/UI",
    description:
      "Diseñamos interfaces intuitivas y atractivas que mejoran la experiencia del usuario y aumentan la conversión.",
    features: ["User Research", "Prototipado", "Design Systems", "Usabilidad"],
  },
  {
    icon: "chart",
    title: "Analytics",
    description:
      "Implementamos herramientas de análisis para ayudarte a entender el comportamiento de tus usuarios.",
    features: [
      "Google Analytics",
      "Power BI",
      "Heatmaps",
      "A/B Testing",
      "Reportes",
    ],
  },
  {
    icon: "wrench",
    title: "Consultoría y Outsourcing de TI",
    description:
      "Ofrecemos soporte continuo y actualizaciones para mantener tu proyecto siempre actualizado y funcionando.",
    features: [
      "Desarrollo de equipos extendidos (staff augmentation)",
      "Consultoría tecnológica (transformación digital, arquitectura, DevOps).",
      "Gestión de proyectos de software end-to-end.",
    ],
  },
] as const;
---

<section id="servicios" class="services section section--split" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Capabilities</div>
      <h2 class="h2">
        Servicios para lanzar, escalar y optimizar
        <span class="gradient-text">productos digitales</span>
      </h2>
      <p class="lead">
        Ofrecemos soluciones completas para llevar tu proyecto digital al
        siguiente nivel
      </p>
    </div>

    <div class="services-grid" data-reveal>
      {
        services.map((service) => (
          <div class="service-card card card-hover" data-tilt="5">
            <div class="service-icon">
              <span class="icon" aria-hidden="true">
                <Icon name={service.icon} size={22} />
              </span>
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
            <ul class="service-features">
              {service.features.map((feature) => (
                <li class="feature-item">{feature}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
  }

  .services::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    background: radial-gradient(
        900px 420px at 50% 0%,
        rgba(139, 92, 246, 0.14) 0%,
        transparent 60%
      ),
      radial-gradient(
        700px 420px at 15% 55%,
        rgba(34, 211, 238, 0.06) 0%,
        transparent 60%
      );
    z-index: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .service-card {
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(167, 139, 250, 0.7) 45%,
      rgba(34, 211, 238, 0.35) 70%,
      transparent 100%
    );
  }

  .service-icon {
    margin-bottom: 1.5rem;
  }

  .icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.92);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 50px rgba(139, 92, 246, 0.12);
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.96);
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .service-description {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .service-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-item {
    color: rgba(255, 255, 255, 0.72);
    padding: 0.5rem 0;
    position: relative;
    padding-left: 1.5rem;
  }

  .feature-item::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: rgba(167, 139, 250, 0.95);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service-card {
      padding: 2rem;
    }
  }

  @media (max-width: 480px) {
    .service-card {
      padding: 1.5rem;
    }

    .icon {
      font-size: 2.5rem;
    }
  }
</style>
