---
---

<section id="hero" class="hero" data-reveal="slow">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-content" data-reveal>
      <div class="kicker">Consultoría · Ingeniería · Marketing · Contenido</div>

      <h1 class="h1">
        Tecnología y estrategia para
        <span class="gradient-text">resultados de negocio</span>.
      </h1>

      <p class="lead hero-lead">
        TLH es una firma de consultoría y desarrollo de software. Unimos
        ingenieros senior, consultores, especialistas en marketing y producción
        audiovisual para diseñar, construir y escalar productos digitales de
        principio a fin.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary cta-primary">Agendar una llamada</a>
        <a href="#portafolio" class="btn btn-secondary">Ver casos de trabajo</a>
      </div>

      <p class="hero-meta">
        Medellín, Colombia — trabajamos con clientes en América Latina y
        Estados Unidos.
      </p>
    </div>

    <div class="hero-visual" data-reveal="right">
      <div class="hero-canvas" id="heroCanvasWrap">
        <div class="hero-orb" aria-hidden="true"></div>
        <canvas id="hero3d" aria-hidden="true"></canvas>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero-scroll-line"></span>
  </div>
</section>

<script>
  import { initHero3D } from "../scripts/hero3d";

  function boot() {
    const canvas = document.getElementById("hero3d") as HTMLCanvasElement | null;
    if (!canvas) return;
    try {
      initHero3D(canvas);
    } catch (err) {
      console.warn("[hero3d] init failed", err);
    }
  }

  if (document.readyState !== "loading") boot();
  else document.addEventListener("DOMContentLoaded", boot);
</script>

<style>
  .hero {
    position: relative;
    padding: calc(72px + clamp(3.5rem, 8vw, 7rem)) 0 clamp(4rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--stroke-1);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
        900px 620px at 78% 8%,
        rgba(124, 58, 237, 0.12) 0%,
        transparent 60%
      ),
      radial-gradient(
        700px 520px at 10% 100%,
        rgba(109, 40, 217, 0.08) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, var(--bg-1) 0%, var(--bg-0) 55%);
  }

  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(23, 19, 32, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 19, 32, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(680px 520px at 72% 20%, #000 0%, transparent 72%);
    -webkit-mask-image: radial-gradient(
      680px 520px at 72% 20%,
      #000 0%,
      transparent 72%
    );
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-content {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .hero-lead {
    max-width: 54ch;
  }

  .hero-cta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    align-items: center;
  }

  .hero-cta :global(.btn) {
    min-height: 50px;
  }

  .hero-meta {
    margin: 0.5rem 0 0;
    color: var(--text-3);
    font-size: 0.92rem;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 440px;
  }

  .hero-canvas {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
  }

  /* CSS fallback orb, shown until (and if) WebGL takes over */
  .hero-orb {
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 30%,
      #c4b5fd 0%,
      #7c3aed 45%,
      #4c1d95 100%
    );
    filter: blur(2px);
    box-shadow: 0 40px 90px rgba(76, 29, 149, 0.35);
    transition: opacity 0.6s ease;
  }

  .hero-canvas.is-ready .hero-orb {
    opacity: 0;
  }

  /* Soft ground glow beneath the form */
  .hero-canvas::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 62%;
    height: 42px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(76, 29, 149, 0.28) 0%,
      transparent 70%
    );
    filter: blur(10px);
    z-index: -1;
  }

  #hero3d {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-3);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    z-index: 1;
  }

  .hero-scroll-line {
    width: 1px;
    height: 34px;
    background: linear-gradient(180deg, var(--brand-1), transparent);
    animation: scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.4;
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
      transform-origin: top;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: calc(62px + 3rem);
    }

    .hero-visual {
      min-height: 340px;
      order: -1;
    }

    .hero-canvas {
      max-width: 360px;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cta-primary {
      width: 100%;
      justify-content: center;
    }

    .hero-canvas {
      max-width: 300px;
    }
  }
</style>
