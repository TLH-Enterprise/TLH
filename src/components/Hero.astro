---
import tlhLogo from "../assets/tlh-sin-fondo.svg";
---

<section id="hero" class="hero section">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="kicker-row">
        <img src={tlhLogo.src} alt="TLH" class="logo" />
        <span class="kicker">Agencia / Consultoría de Software</span>
      </div>

      <h1 class="h1">
        Software de alto impacto para equipos que exigen
        <span class="gradient-text">claridad, velocidad y calidad</span>.
      </h1>

      <p class="lead hero-lead">
        Construimos productos web y móviles listos para escalar: arquitectura,
        UX/UI, desarrollo y delivery continuo. Menos fricción. Más resultados.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary">Agendar llamada</a>
        <a href="#portafolio" class="btn btn-secondary">Ver casos</a>
      </div>

      <div class="proof">
        <div class="proof-item">
          <div class="proof-title">Entrega</div>
          <div class="proof-value">Sprint a Sprint</div>
        </div>
        <div class="proof-item">
          <div class="proof-title">Stack</div>
          <div class="proof-value">Web · Mobile · IA</div>
        </div>
        <div class="proof-item">
          <div class="proof-title">Enfoque</div>
          <div class="proof-value">Performance & SEO</div>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>

      <div class="showcase card">
        <div class="showcase-top">
          <div class="dot dot-1"></div>
          <div class="dot dot-2"></div>
          <div class="dot dot-3"></div>
          <div class="showcase-title">TLH Delivery</div>
        </div>
        <div class="showcase-body">
          <div class="metric">
            <div class="metric-k">Time to value</div>
            <div class="metric-v">Semanas</div>
          </div>
          <div class="metric">
            <div class="metric-k">Calidad</div>
            <div class="metric-v">Checklist + QA</div>
          </div>
          <div class="metric">
            <div class="metric-k">Escala</div>
            <div class="metric-v">Arquitectura</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: -1px;
    pointer-events: none;
    background: radial-gradient(800px 500px at 18% 65%, rgba(139, 92, 246, 0.28) 0%, transparent 60%),
      radial-gradient(700px 500px at 80% 30%, rgba(34, 211, 238, 0.12) 0%, transparent 60%);
    filter: blur(0px);
    z-index: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.2rem, 5vw, 4.2rem);
    align-items: center;
  }

  .hero-content {
    display: grid;
    gap: 1.35rem;
  }

  .kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .logo {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 10px 30px rgba(139, 92, 246, 0.35));
  }

  .hero-lead {
    margin: 0;
    max-width: 62ch;
  }

  .hero-cta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .proof-item {
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
  }

  .proof-title {
    color: rgba(255, 255, 255, 0.56);
    font-weight: 650;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-value {
    margin-top: 0.25rem;
    font-weight: 720;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero-visual {
    position: relative;
    min-height: 520px;
  }

  .orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(0px);
    opacity: 0.95;
    animation: drift 12s ease-in-out infinite;
  }

  .orb-1 {
    width: 260px;
    height: 260px;
    top: 6%;
    left: 8%;
    background: radial-gradient(circle at 30% 30%, rgba(167, 139, 250, 0.9), rgba(139, 92, 246, 0.08) 70%, transparent 75%);
    animation-duration: 13s;
  }

  .orb-2 {
    width: 220px;
    height: 220px;
    bottom: 10%;
    right: 6%;
    background: radial-gradient(circle at 30% 30%, rgba(34, 211, 238, 0.6), rgba(34, 211, 238, 0.06) 70%, transparent 78%);
    animation-duration: 16s;
    animation-direction: reverse;
  }

  .orb-3 {
    width: 160px;
    height: 160px;
    top: 42%;
    right: 28%;
    background: radial-gradient(circle at 30% 30%, rgba(139, 92, 246, 0.55), rgba(139, 92, 246, 0.05) 70%, transparent 78%);
    animation-duration: 14s;
  }

  .showcase {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(520px, 100%);
    max-width: 520px;
    height: 360px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .showcase::before {
    content: "";
    position: absolute;
    inset: -1px;
    background: radial-gradient(600px 220px at 20% 30%, rgba(139, 92, 246, 0.22) 0%, transparent 60%),
      radial-gradient(500px 240px at 80% 70%, rgba(34, 211, 238, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  .showcase-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.18);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    opacity: 0.9;
  }

  .dot-1 {
    background: rgba(239, 68, 68, 0.9);
  }
  .dot-2 {
    background: rgba(245, 158, 11, 0.9);
  }
  .dot-3 {
    background: rgba(34, 197, 94, 0.9);
  }

  .showcase-title {
    margin-left: 0.4rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    letter-spacing: -0.01em;
  }

  .showcase-body {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1.2rem;
  }

  .metric {
    padding: 1rem 1rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .metric-k {
    color: rgba(255, 255, 255, 0.58);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .metric-v {
    margin-top: 0.25rem;
    font-weight: 780;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -16px, 0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .proof {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: 420px;
    }

    .showcase {
      height: 320px;
    }
  }

  @media (max-width: 480px) {
    .kicker-row {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
