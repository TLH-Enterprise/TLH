---
import tlhLogo from "../assets/tlh-sin-fondo.svg";
---

<section id="hero" class="hero section" data-reveal="slow">
  <div class="signal-lines" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-content" data-reveal>
      <div class="kicker-row">
        <img src={tlhLogo.src} alt="TLH" class="logo" />
        <span class="kicker">Agencia / Consultoría de Software</span>
      </div>

      <h1 class="h1">
        Construimos productos digitales que tu equipo puede
        <span class="gradient-text">operar y escalar</span>.
      </h1>

      <p class="lead hero-lead">
        Somos tu partner de ingeniería y diseño: definimos el alcance, reducimos
        riesgo, y entregamos incrementos listos para producción con calidad
        medible.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary" data-magnetic="12">Agendar llamada</a>
        <a href="#portafolio" class="btn btn-secondary" data-magnetic="10">Ver casos</a>
      </div>

      <div class="proof">
        <div class="proof-item">
          <div class="proof-title">Discovery</div>
          <div class="proof-value">1–2 semanas</div>
        </div>
        <div class="proof-item">
          <div class="proof-title">Entrega</div>
          <div class="proof-value">Incremental</div>
        </div>
        <div class="proof-item">
          <div class="proof-title">Estandares</div>
          <div class="proof-value">Performance · QA</div>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true" data-reveal="right">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>

      <div class="hero-panel" data-tilt="3">
        <div class="panel-col">
          <div class="panel-title">Qué hacemos</div>
          <ul class="panel-list">
            <li>Plataformas web y aplicaciones</li>
            <li>Diseño UX/UI y Design Systems</li>
            <li>Arquitectura, performance y SEO</li>
          </ul>
        </div>
        <div class="panel-divider" role="presentation"></div>
        <div class="panel-col">
          <div class="panel-title">Cómo trabajamos</div>
          <ul class="panel-list">
            <li>Discovery corto + alcance claro</li>
            <li>Entrega incremental (release-ready)</li>
            <li>Calidad: QA + métricas</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: -1px;
    pointer-events: none;
    background: radial-gradient(800px 500px at 18% 65%, rgba(139, 92, 246, 0.28) 0%, transparent 60%),
      radial-gradient(700px 500px at 80% 30%, rgba(34, 211, 238, 0.12) 0%, transparent 60%);
    filter: blur(0px);
    z-index: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.2rem, 5vw, 4.2rem);
    align-items: center;
  }

  .hero-content {
    display: grid;
    gap: 1.35rem;
  }

  .kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .logo {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 10px 30px rgba(139, 92, 246, 0.35));
  }

  .hero-lead {
    margin: 0;
    max-width: 62ch;
  }

  .hero-cta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .proof-item {
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
  }

  .proof-title {
    color: rgba(255, 255, 255, 0.56);
    font-weight: 650;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-value {
    margin-top: 0.25rem;
    font-weight: 720;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero-visual {
    position: relative;
    min-height: 520px;
  }

  .orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(0px);
    opacity: 0.95;
    animation: drift 12s ease-in-out infinite;
  }

  .orb-1 {
    width: 260px;
    height: 260px;
    top: 6%;
    left: 8%;
    background: radial-gradient(circle at 30% 30%, rgba(167, 139, 250, 0.9), rgba(139, 92, 246, 0.08) 70%, transparent 75%);
    animation-duration: 13s;
  }

  .orb-2 {
    width: 220px;
    height: 220px;
    bottom: 10%;
    right: 6%;
    background: radial-gradient(circle at 30% 30%, rgba(34, 211, 238, 0.6), rgba(34, 211, 238, 0.06) 70%, transparent 78%);
    animation-duration: 16s;
    animation-direction: reverse;
  }

  .orb-3 {
    width: 160px;
    height: 160px;
    top: 42%;
    right: 28%;
    background: radial-gradient(circle at 30% 30%, rgba(139, 92, 246, 0.55), rgba(139, 92, 246, 0.05) 70%, transparent 78%);
    animation-duration: 14s;
  }

  .hero-panel {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(520px, 100%);
    max-width: 520px;
    min-height: 320px;
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 46px 140px rgba(0, 0, 0, 0.62);
    overflow: hidden;
    backdrop-filter: blur(14px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    isolation: isolate;
  }

  .hero-panel::before {
    content: "";
    position: absolute;
    inset: -1px;
    background: radial-gradient(
        600px 260px at 18% 22%,
        rgba(139, 92, 246, 0.22) 0%,
        transparent 60%
      ),
      radial-gradient(
        520px 260px at 80% 75%,
        rgba(34, 211, 238, 0.1) 0%,
        transparent 60%
      );
    pointer-events: none;
    z-index: 0;
  }

  .panel-col {
    position: relative;
    padding: 1.4rem 1.35rem;
    z-index: 1;
  }

  .panel-title {
    color: rgba(255, 255, 255, 0.86);
    font-weight: 780;
    letter-spacing: -0.02em;
    font-size: 1.15rem;
  }

  .panel-list {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.65rem;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.6;
    font-size: 1rem;
  }

  .panel-list li {
    position: relative;
    padding-left: 1.1rem;
  }

  .panel-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.85);
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
  }

  .panel-divider {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 255, 255, 0.12) 18%,
      rgba(167, 139, 250, 0.2) 50%,
      rgba(255, 255, 255, 0.12) 82%,
      transparent 100%
    );
    opacity: 0.9;
    z-index: 1;
    justify-self: stretch;
  }

  .hero-panel:hover {
    border-color: rgba(167, 139, 250, 0.22);
    background: rgba(0, 0, 0, 0.5);
    box-shadow: 0 54px 170px rgba(0, 0, 0, 0.68);
  }

  @media (max-width: 540px) {
    .hero-panel {
      grid-template-columns: 1fr;
    }

    .panel-divider {
      width: 100%;
      height: 1px;
      justify-self: auto;
    }

    .panel-col {
      padding: 1.2rem 1.15rem;
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -16px, 0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .proof {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: 420px;
    }

    .hero-panel {
      min-height: 300px;
    }
  }

  @media (max-width: 480px) {
    .kicker-row {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
