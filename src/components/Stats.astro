---
const principles = [
  {
    title: "Equipo senior y directo",
    description:
      "Hablas con las personas que diseñan y construyen tu proyecto, sin capas de intermediarios ni pérdida de contexto.",
  },
  {
    title: "Entregas iterativas y medibles",
    description:
      "Avances demostrables en ciclos cortos, con comunicación constante y prioridades claras en cada etapa.",
  },
  {
    title: "Cuatro disciplinas, un solo socio",
    description:
      "Ingeniería, consultoría, marketing y contenido trabajan como un mismo equipo: menos fricción, más consistencia.",
  },
] as const;
---

<section class="principles section" aria-label="Cómo trabajamos" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Por qué TLH</div>
      <h2 class="h2">
        Una forma de trabajar pensada para
        <span class="gradient-text">reducir riesgo</span>
      </h2>
      <p class="lead">
        No prometemos cifras infladas: ofrecemos una forma de trabajo clara,
        con responsables visibles y entregas que puedes verificar.
      </p>
    </div>

    <div class="principles-grid" data-reveal>
      {
        principles.map((p, i) => (
          <div class="principle">
            <div class="principle-number">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="principle-title">{p.title}</h3>
            <p class="principle-description">{p.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--stroke-1);
  }

  .principle {
    padding: 2rem 2rem 2rem 0;
  }

  .principle + .principle {
    padding-left: 2rem;
    border-left: 1px solid var(--stroke-1);
  }

  .principle-number {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-1);
    font-variant-numeric: tabular-nums;
  }

  .principle-title {
    font-family: var(--font-display);
    margin: 0.75rem 0 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
  }

  .principle-description {
    margin: 0.6rem 0 0;
    color: var(--text-2);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }

    .principle {
      padding: 1.75rem 0;
      border-bottom: 1px solid var(--stroke-1);
    }

    .principle + .principle {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
