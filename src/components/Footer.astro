---
import { Image } from "astro:assets";

const socialLinks = [
  {
    name: "LinkedIn",
    key: "linkedin",
    href: "https://www.linkedin.com/company/tlh-the-last-hope",
  },
  { name: "X", key: "x", href: "https://x.com/tlh_dev" },
  { name: "Instagram", key: "instagram", href: "https://www.instagram.com/tlh.dev/" },
] as const;
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="brand-logo">
          <Image
            src="/tlh.ico"
            alt="TLH Logo"
            class="logo"
            width={100}
            height={100}
          />
          <span class="brand-name">TLH</span>
        </div>
        <p class="brand-description">
          Transformamos ideas en experiencias digitales excepcionales. Creamos
          soluciones web modernas que impulsan el crecimiento de tu negocio.
        </p>
        <div class="social-links">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="social-link"
                target="_blank"
                rel="noopener"
                aria-label={social.name}
              >
                <span class="social-icon" aria-hidden="true">
                  {
                    social.key === "linkedin" ? (
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M6.5 10.5V18.5"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                        <path
                          d="M6.5 7.25h0.01"
                          stroke="currentColor"
                          stroke-width="3.2"
                          stroke-linecap="round"
                        />
                        <path
                          d="M10.5 18.5v-4.4c0-1.8 1.1-3 2.8-3 1.6 0 2.4 1.1 2.4 3v4.4"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M10.5 10.5v1.2"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                      </svg>
                    ) : social.key === "x" ? (
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M7 7h3.2l6.8 10H13.8L7 7Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M17 7h-3l-7 10h3l7-10Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                      </svg>
                    ) : (
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <rect
                          x="7"
                          y="7"
                          width="10"
                          height="10"
                          rx="3"
                          stroke="currentColor"
                          stroke-width="1.8"
                        />
                        <path
                          d="M16.2 7.8h0.01"
                          stroke="currentColor"
                          stroke-width="3.2"
                          stroke-linecap="round"
                        />
                        <path
                          d="M12 11a1.9 1.9 0 1 0 0 3.8A1.9 1.9 0 0 0 12 11Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )
                  }
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p class="copyright">
          © {new Date().getFullYear()} TLH. Todos los derechos reservados.
        </p>
        <div class="footer-bottom-links">
          <span class="location-text">Medellín, Colombia</span>
        </div>
      </div>
    </div>

    <div class="footer-background">
      <div class="bg-element bg-element-1"></div>
      <div class="bg-element bg-element-2"></div>
      <div class="bg-element bg-element-3"></div>
    </div>
  </div>

  <style>
    .footer {
      position: relative;
      overflow: hidden;
      padding: 4rem 0 0;
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .footer::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(167, 139, 250, 0.95) 50%,
        transparent 100%
      );
    }

    .footer-background {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      pointer-events: none;
    }

    .bg-element {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        rgba(139, 92, 246, 0.12) 0%,
        transparent 70%
      );
      animation: float 20s ease-in-out infinite;
    }

    .bg-element-1 {
      width: 300px;
      height: 300px;
      top: 20%;
      left: 10%;
      animation-delay: 0s;
    }

    .bg-element-2 {
      width: 200px;
      height: 200px;
      top: 60%;
      right: 20%;
      animation-delay: -7s;
    }

    .bg-element-3 {
      width: 150px;
      height: 150px;
      bottom: 20%;
      left: 60%;
      animation-delay: -14s;
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }
      50% {
        transform: translateY(-30px) rotate(180deg);
      }
    }

    .container {
      position: relative;
      z-index: 2;
    }

    .footer-main {
      flex: 1;
      margin-bottom: 3rem;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .footer-content {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
      margin-bottom: 3rem;
    }

    .footer-brand {
      max-width: 100%;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      width: 100%;
    }

    .logo {
      width: 40px;
      height: 40px;
      filter: drop-shadow(0 12px 30px rgba(139, 92, 246, 0.22));
    }

    .brand-name {
      font-size: 1.8rem;
      font-weight: 800;
      background: linear-gradient(
        135deg,
        rgba(167, 139, 250, 0.95) 0%,
        rgba(139, 92, 246, 0.95) 60%,
        rgba(34, 211, 238, 0.6) 140%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .brand-description {
      color: rgba(255, 255, 255, 0.72);
      line-height: 1.6;
      margin: 0 0 2rem 0;
      text-align: center;
      max-width: 600px;
    }

    .social-links {
      display: flex;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .social-link {
      width: 45px;
      height: 45px;
      background: rgba(255, 255, 255, 0.045);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .social-link:hover {
      background: linear-gradient(
        135deg,
        rgba(139, 92, 246, 0.95) 0%,
        rgba(109, 40, 217, 0.95) 70%,
        rgba(34, 211, 238, 0.35) 140%
      );
      border-color: transparent;
      transform: translateY(-2px);
    }

    .social-icon {
      width: 22px;
      height: 22px;
      color: rgba(255, 255, 255, 0.88);
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .link-group {
      min-width: 0;
    }

    .link-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 1.5rem 0;
    }

    .link-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .link-item {
      display: block;
      color: #a0a0a0;
      text-decoration: none;
      padding: 0.5rem 0;
      transition: color 0.3s ease;
      font-size: 0.95rem;
    }

    .link-item:hover {
      color: #667eea;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 2rem 0;
      margin-top: auto;
    }

    .footer-bottom-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      width: 100%;
      max-width: 100%;
    }

    .copyright {
      color: rgba(255, 255, 255, 0.56);
      margin: 0;
      font-size: 0.9rem;
    }

    .footer-bottom-links {
      display: flex;
      gap: 2rem;
    }

    .location-text {
      color: rgba(255, 255, 255, 0.56);
      font-size: 0.9rem;
      margin: 0;
    }

    /* Large desktop styles */
    @media screen and (min-width: 1400px) {
      .container {
        padding: 0 3rem;
      }

      .footer-brand {
        max-width: 100%;
      }

      .footer-bottom-content {
        padding: 0 1rem;
      }
    }

    @media (max-width: 1024px) {
      .container {
        padding: 0 1.5rem;
      }

      .footer-brand {
        max-width: 100%;
      }

      .brand-description {
        max-width: 500px;
      }
    }

    @media (max-width: 768px) {
      .footer {
        padding: 3rem 0 0;
      }

      .container {
        padding: 0 1rem;
      }

      .footer-main {
        margin-bottom: 2rem;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 3rem;
      }

      .footer-brand {
        text-align: center;
      }

      .brand-logo {
        justify-content: center;
        width: 100%;
      }

      .brand-description {
        max-width: 100%;
        text-align: center;
      }

      .social-links {
        justify-content: center;
        width: 100%;
      }

      .footer-links {
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
      }

      .footer-bottom {
        margin-top: auto;
      }

      .footer-bottom-content {
        flex-direction: column;
        text-align: center;
        width: 100%;
      }

      .footer-bottom-links {
        gap: 1rem;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0 0.75rem;
      }

      .footer-links {
        grid-template-columns: 1fr;
      }

      .footer-brand {
        text-align: center;
      }

      .brand-logo {
        justify-content: center;
        width: 100%;
      }

      .social-links {
        justify-content: center;
        width: 100%;
      }

      .brand-description {
        text-align: center;
        max-width: 100%;
      }

      .footer-bottom-content {
        padding: 0 0.5rem;
      }
    }
  </style>
</footer>
