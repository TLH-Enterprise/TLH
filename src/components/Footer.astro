---
import { Image } from "astro:assets";

const socialLinks = [
  {
    name: "LinkedIn",
    key: "linkedin",
    href: "https://www.linkedin.com/company/tlh-the-last-hope",
  },
  {
    name: "Instagram",
    key: "instagram",
    href: "https://www.instagram.com/tlh.esports/",
  },
] as const;

const footerLinks = [
  { name: "Servicios", href: "#servicios" },
  { name: "Portafolio", href: "#portafolio" },
  { name: "Proceso", href: "#proceso" },
  { name: "Contacto", href: "#contacto" },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="brand-logo">
          <Image
            src="/tlh.ico"
            alt="TLH Logo"
            class="logo"
            width={100}
            height={100}
          />
          <span class="brand-name">TLH</span>
        </div>
        <p class="brand-description">
          Firma de consultoría y desarrollo de software. Construimos productos
          digitales, integramos IA y ejecutamos estrategias de marketing y
          contenido para empresas.
        </p>
      </div>

      <div class="footer-nav">
        <div class="footer-nav-title">Navegación</div>
        <ul class="footer-nav-list">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="footer-link">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-social">
        <div class="footer-nav-title">Síguenos</div>
        <div class="social-links">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="social-link"
                target="_blank"
                rel="noopener"
                aria-label={social.name}
              >
                <span class="social-icon" aria-hidden="true">
                  {
                    social.key === "linkedin" ? (
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M6.5 10.5V18.5"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                        <path
                          d="M6.5 7.25h0.01"
                          stroke="currentColor"
                          stroke-width="3.2"
                          stroke-linecap="round"
                        />
                        <path
                          d="M10.5 18.5v-4.4c0-1.8 1.1-3 2.8-3 1.6 0 2.4 1.1 2.4 3v4.4"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M10.5 10.5v1.2"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                      </svg>
                    ) : social.key === "x" ? (
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M7 7h3.2l6.8 10H13.8L7 7Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M17 7h-3l-7 10h3l7-10Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                      </svg>
                    ) : (
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <rect
                          x="7"
                          y="7"
                          width="10"
                          height="10"
                          rx="3"
                          stroke="currentColor"
                          stroke-width="1.8"
                        />
                        <path
                          d="M16.2 7.8h0.01"
                          stroke="currentColor"
                          stroke-width="3.2"
                          stroke-linecap="round"
                        />
                        <path
                          d="M12 11a1.9 1.9 0 1 0 0 3.8A1.9 1.9 0 0 0 12 11Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )
                  }
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} TLH. Todos los derechos reservados.
      </p>
      <span class="location-text">Medellín, Colombia</span>
    </div>
  </div>

  <style>
    .footer {
      position: relative;
      background: var(--dark-0);
      color: rgba(255, 255, 255, 0.85);
      padding: 4rem 0 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
    }

    .footer::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: radial-gradient(
        700px 320px at 15% 0%,
        rgba(124, 58, 237, 0.22) 0%,
        transparent 60%
      );
    }

    .footer .container {
      position: relative;
      z-index: 1;
    }

    .footer-main {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
      padding-bottom: 3rem;
    }

    .footer-brand {
      max-width: 420px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .logo {
      width: 36px;
      height: 36px;
    }

    .brand-name {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #ffffff;
    }

    .brand-description {
      color: rgba(255, 255, 255, 0.62);
      line-height: 1.65;
      margin: 0;
      font-size: 0.98rem;
    }

    .footer-nav-title {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 1.15rem;
    }

    .footer-nav-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.6rem;
    }

    .footer-link {
      color: rgba(255, 255, 255, 0.78);
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.18s ease;
    }

    .footer-link:hover {
      color: #c4b5fd;
    }

    .social-links {
      display: flex;
      gap: 0.75rem;
    }

    .social-link {
      width: 40px;
      height: 40px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.85);
      transition: border-color 0.18s ease, color 0.18s ease;
    }

    .social-link:hover {
      border-color: #a78bfa;
      color: #c4b5fd;
    }

    .social-icon {
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding: 1.5rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .copyright,
    .location-text {
      color: rgba(255, 255, 255, 0.5);
      margin: 0;
      font-size: 0.88rem;
    }

    @media (max-width: 768px) {
      .footer {
        padding: 3rem 0 0;
      }

      .footer-main {
        grid-template-columns: 1fr;
        gap: 2.25rem;
      }

      .footer-bottom {
        flex-direction: column;
        text-align: center;
      }
    }
  </style>
</footer>
