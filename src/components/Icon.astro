---
export interface Props {
  name:
    | "rocket"
    | "mobile"
    | "spark"
    | "palette"
    | "chart"
    | "wrench"
    | "camera"
    | "megaphone"
    | "search"
    | "clipboard"
    | "layers"
    | "bolt"
    | "launch"
    | "shield";
  size?: number;
  title?: string;
}

const { name, size = 22, title } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  xmlns: "http://www.w3.org/2000/svg",
  "aria-hidden": title ? undefined : "true",
  role: title ? "img" : "presentation",
} as const;
---

<svg {...common}>
  {title ? <title>{title}</title> : null}
  <g
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      name === "rocket" ? (
        <>
          <path d="M5 13c1.5 1.5 4.5 1.5 6 0l7-7c1.5-1.5 1.5-4.5 0-6l-7 7c-1.5 1.5-1.5 4.5 0 6Z" />
          <path d="M7 11 3 15v6h6l4-4" />
          <path d="M14.5 3.5 20.5 9.5" />
        </>
      ) : null
    }
    {
      name === "mobile" ? (
        <>
          <rect x="8" y="3" width="8" height="18" rx="2" />
          <path d="M11 18h2" />
        </>
      ) : null
    }
    {
      name === "spark" ? (
        <>
          <path d="M12 2v4" />
          <path d="M12 18v4" />
          <path d="M4.93 4.93 7.76 7.76" />
          <path d="M16.24 16.24l2.83 2.83" />
          <path d="M2 12h4" />
          <path d="M18 12h4" />
          <path d="M4.93 19.07l2.83-2.83" />
          <path d="M16.24 7.76l2.83-2.83" />
          <circle cx="12" cy="12" r="3" />
        </>
      ) : null
    }
    {
      name === "palette" ? (
        <>
          <path d="M12 3c5 0 9 3.6 9 8.2 0 2.3-1.6 3.8-3.6 3.8H16c-1 0-1.8.8-1.8 1.8S13.4 19 12 19c-5 0-9-3.6-9-8.2C3 6.6 7 3 12 3Z" />
          <path d="M7.5 11.2h0.01" />
          <path d="M10.2 8.8h0.01" />
          <path d="M13.6 8.6h0.01" />
          <path d="M16.4 10.8h0.01" />
        </>
      ) : null
    }
    {
      name === "chart" ? (
        <>
          <path d="M4 19V5" />
          <path d="M4 19h16" />
          <path d="M8 15v-4" />
          <path d="M12 15V7" />
          <path d="M16 15v-6" />
        </>
      ) : null
    }
    {
      name === "wrench" ? (
        <>
          <path d="M21 7a6 6 0 0 1-8.5 5.5L7 18l-3-3 5.5-5.5A6 6 0 0 1 17 3l-3 3 4 4 3-3Z" />
        </>
      ) : null
    }
    {
      name === "camera" ? (
        <>
          <path d="M7 7h10l2 3v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-9l2-3Z" />
          <circle cx="12" cy="14" r="3" />
        </>
      ) : null
    }
    {
      name === "megaphone" ? (
        <>
          <path d="M4 11v2a2 2 0 0 0 2 2h1l5 3V6L7 9H6a2 2 0 0 0-2 2Z" />
          <path d="M16 10v4" />
          <path d="M19 9v6" />
        </>
      ) : null
    }
    {
      name === "search" ? (
        <>
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </>
      ) : null
    }
    {
      name === "clipboard" ? (
        <>
          <rect x="7" y="4" width="10" height="16" rx="2" />
          <path d="M9 4.5h6" />
          <path d="M9 9h6" />
          <path d="M9 13h6" />
        </>
      ) : null
    }
    {
      name === "layers" ? (
        <>
          <path d="M12 3 3 8l9 5 9-5-9-5Z" />
          <path d="M3 12l9 5 9-5" />
          <path d="M3 16l9 5 9-5" />
        </>
      ) : null
    }
    {
      name === "bolt" ? (
        <>
          <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" />
        </>
      ) : null
    }
    {
      name === "launch" ? (
        <>
          <path d="M14 10 21 3" />
          <path d="M15 3h6v6" />
          <path d="M21 13v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7" />
        </>
      ) : null
    }
    {
      name === "shield" ? (
        <>
