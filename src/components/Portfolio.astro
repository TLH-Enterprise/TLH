---
import { Image } from "astro:assets";

const projects = [
  {
    title: "Premium Academy",
    description:
      "Plataforma de educación online con acceso a cursos premium, pagos con Stripe y materiales exclusivos para estudiantes.",
    image: "/projects/premium-academy.png",
    technologies: ["React", "Node.js", "MongoDB", "Stripe"],
    category: "Desarrollo web",
    link: "https://www.premiumacademy.pro",
  },
  {
    title: "Arcopedico USA",
    description:
      "Migración de la plataforma de e-commerce a una nueva infraestructura en AWS para mejorar el rendimiento y la escalabilidad.",
    image: "/projects/arcopedicousa.png",
    technologies: ["AWS", "WordPress", "PHP", "JavaScript"],
    category: "Outsourcing TI",
    link: "https://arcopedicousa.com",
  },
  // Pendientes de assets (imagen, enlace y descripción definitiva):
  // { title: "Aliantia", ... },
  // { title: "Renovation Ideas", ... },
];
---

<section id="portafolio" class="portfolio section section--dark" data-reveal="slow">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="kicker">Casos de trabajo</div>
      <h2 class="h2">
        Proyectos que demuestran
        <span class="gradient-text">ejecución y detalle</span>
      </h2>
      <p class="lead">
        Una muestra del trabajo que hemos construido y operado para nuestros
        clientes.
      </p>
    </div>

    <div class="portfolio-grid" data-reveal data-stagger>
      {
        projects.map((project) => (
          <a
            class="portfolio-item card card-hover"
            href={project.link}
            target="_blank"
            rel="noopener"
          >
            <div class="portfolio-image">
              <Image
                src={project.image}
                alt={project.title}
                width={640}
                height={400}
              />
            </div>
            <div class="portfolio-content">
              <div class="portfolio-category">{project.category}</div>
              <h3 class="portfolio-title">{project.title}</h3>
              <p class="portfolio-description">{project.description}</p>
              <div class="portfolio-technologies">
                {project.technologies.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              <span class="portfolio-link">
                Ver proyecto <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="portfolio-cta" data-reveal>
      <div class="cta-text">
        <h3>¿Tienes un proyecto en mente?</h3>
        <p>Hablemos sobre cómo podemos ayudarte a hacerlo realidad.</p>
      </div>
      <a href="#contacto" class="btn btn-primary">Iniciar conversación</a>
    </div>
  </div>
</section>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .portfolio-item {
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .portfolio-image {
    height: 260px;
    overflow: hidden;
    border-bottom: 1px solid var(--stroke-1);
  }

  .portfolio-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .portfolio-item:hover .portfolio-image img {
    transform: scale(1.03);
  }

  .portfolio-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .portfolio-category {
    color: var(--brand-1);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .portfolio-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.015em;
    margin: 0 0 0.65rem 0;
  }

  .portfolio-description {
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 1.25rem 0;
  }

  .portfolio-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    background: var(--bg-1);
    border: 1px solid var(--stroke-1);
    color: var(--text-2);
    padding: 0.25rem 0.7rem;
    border-radius: var(--r-sm);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .portfolio-link {
    margin-top: auto;
    color: var(--brand-1);
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .portfolio-item:hover .portfolio-link span {
    transform: translateX(3px);
  }

  .portfolio-link span {
    transition: transform 0.18s ease;
  }

  .portfolio-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.25rem;
    background: var(--bg-1);
    border: 1px solid var(--stroke-1);
    border-left: 3px solid var(--brand-1);
    border-radius: var(--r-md);
  }

  .cta-text h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem 0;
  }

  .cta-text p {
    color: var(--text-2);
    margin: 0;
  }

  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }

    .portfolio-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .portfolio-content {
      padding: 1.4rem;
    }

    .portfolio-image {
      height: 200px;
    }

    .portfolio-cta .btn {
      width: 100%;
    }
  }
</style>
